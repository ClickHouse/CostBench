# =============================================================================
# Snowflake benchmark — secrets & local artifacts. NEVER commit credentials.
# (The repo-root .gitignore also covers out/, __pycache__, .venv, .DS_Store, .env*.)
# =============================================================================

# --- Secrets: key-pair, profiles, env files, AWS session tokens ---
keys/
*.p8
*.pem
profile.json
.sfenv
_credentials_aws.txt
.env
.env.*
!.env.example

# --- Runner output / logs (regenerated each run) ---
out/
ingest.log

# --- Local / generated ---
__pycache__/
*.py[cod]
.DS_Store

run8/
run12/
run14/

# Accepted Run 14 evidence is intentionally versioned. Keep other local cost
# output and ad hoc chart runs ignored while allowing the canonical artifacts.
!costs/out/
costs/out/*
!costs/out/t2/
costs/out/t2/*
!costs/out/t2/run14/
!costs/out/t2/run14/**
!results/t2/charts/run14/
!results/t2/charts/run14/**
